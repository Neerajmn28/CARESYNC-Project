{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-caresync26"
		},
		"AzureDatabricks1_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1026-163419-urm7jmpo"
		},
		"AzureKeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://Caresynckeyvaultn.vault.azure.net/"
		},
		"LSADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://caresyncstorageaccn.dfs.core.windows.net/"
		},
		"LSAzureSqlDatabaseN_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "caresync-server-n.database.windows.net"
		},
		"LSAzureSqlDatabaseN_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sql-db-caresync"
		},
		"LSAzureSqlDatabaseN_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "neerajmn"
		},
		"LSPostgressql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-shy-silence-babkcl19-pooler.c-8.eu-central-1.aws.neon.tech"
		},
		"LSPostgressql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"LSPostgressql_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-caresync26_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureKeyVault_properties_typeProperties_baseUrl": {
						"value": "[parameters('AzureKeyVault_properties_typeProperties_baseUrl')]"
					},
					"LSADLS_properties_typeProperties_url": {
						"value": "[parameters('LSADLS_properties_typeProperties_url')]"
					},
					"AzureDatabricks1_properties_typeProperties_existingClusterId": {
						"value": "[parameters('AzureDatabricks1_properties_typeProperties_existingClusterId')]"
					},
					"LSAzureSqlDatabaseN_properties_typeProperties_server": {
						"value": "[parameters('LSAzureSqlDatabaseN_properties_typeProperties_server')]"
					},
					"LSAzureSqlDatabaseN_properties_typeProperties_database": {
						"value": "[parameters('LSAzureSqlDatabaseN_properties_typeProperties_database')]"
					},
					"LSAzureSqlDatabaseN_properties_typeProperties_userName": {
						"value": "[parameters('LSAzureSqlDatabaseN_properties_typeProperties_userName')]"
					},
					"LSPostgressql_properties_typeProperties_server": {
						"value": "[parameters('LSPostgressql_properties_typeProperties_server')]"
					},
					"LSPostgressql_properties_typeProperties_database": {
						"value": "[parameters('LSPostgressql_properties_typeProperties_database')]"
					},
					"LSPostgressql_properties_typeProperties_username": {
						"value": "[parameters('LSPostgressql_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}